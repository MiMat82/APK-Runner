<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Version>12.11.0</Version>
    <AssemblyName>APKRunner</AssemblyName>
    <StartupObject>APKRunner.Program</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationIcon>../assets/branding/apk-runner.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Optimize>true</Optimize>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="preview/*.cs" />
    <Reference Include="System.Windows.Forms"/><Reference Include="System.Drawing"/>
    <Reference Include="System.Management"/><Reference Include="System.Web.Extensions"/>
    <Reference Include="System.Xml.Linq"/><Reference Include="System.IO.Compression"/>
    <Reference Include="System.IO.Compression.FileSystem"/>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All"/>
    <PackageReference Include="Velopack" Version="1.2.161"/>
    <EmbeddedResource Include="../assets/branding/apk-runner-logo.png" LogicalName="APKRunner.BrandLogo.png"/>
    <EmbeddedResource Include="../assets/branding/apk-runner.ico" LogicalName="APKRunner.BrandIcon.ico"/>
    <Content Include="../licenses/*.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
